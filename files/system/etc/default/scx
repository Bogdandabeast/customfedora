# scx scheduler config — managed by bluebuild (recipe.niri-cachyos.yml)
# scx_cake: scheduler sched_ext orientado a respuesta en juegos/uso general.
# Usa su política por defecto; no tiene perfiles ni sigue a PPD, así que
# --autopower/--powersave NO se pasan aquí (se ignorarían con un warning).
# Ajustes opcionales vía --toggle, p. ej. SCX_FLAGS=--toggle g89=0
# Ver `scx_cake --help` para flags y toggles.
SCX_SCHEDULER=scx_cake
SCX_FLAGS=

# ALTERNATIVA: máxima respuesta con logging (más ruido en el journal)
#SCX_FLAGS=--verbose
