# Toggle passwordless para el widget Noctalia lid-mode.
# Permite `ujust setup-lid-lock` / `setup-hibernate` sin password cuando se hace click en el navbar.
# Solo los binarios que usan esos justfiles; no es NOPASSWD ALL.
%wheel ALL=(ALL) NOPASSWD: /usr/bin/rpm-ostree, /usr/bin/tee, /usr/bin/sed, /usr/bin/mkdir, /usr/sbin/swapon, /usr/bin/blkid, /usr/sbin/filefrag, /usr/bin/btrfs, /usr/bin/kill, /usr/bin/systemctl, /usr/bin/noctalia-lid-mode-toggle.sh, /usr/bin/noctalia-lid-mode-sync.sh, /usr/bin/btrfs
