// Niri configuration for the Noctalia desktop shell.

// Start Noctalia once per session; it provides the bar, launcher,
// notifications, wallpaper, OSD, lock screen, and session menu.
spawn-at-startup "noctalia"

// Open a terminal (workspace 3) and Brave (workspace 1) at login;
// the window-rules below place them on their assigned workspaces.
// Brave is launched via the shell with a short delay so the Flatpak
// runtime is mounted before it starts.
spawn-at-startup "alacritty"
spawn-sh-at-startup "sleep 2 && flatpak run com.brave.Browser"

binds {
    // Core Noctalia surfaces
    Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+D { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+S { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Comma { spawn-sh "noctalia msg settings-toggle"; }
    Mod+Tab { spawn-sh "noctalia msg window-switcher"; }
    Mod+W { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Mod+E { spawn-sh "noctalia msg panel-toggle session"; }
    Mod+V { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+Shift+L allow-when-locked=true { spawn-sh "noctalia msg session lock"; }

    // Terminal (from Sway: Mod+Return)
    Mod+Return { spawn "alacritty"; }

    // Window control (from Sway: Mod+Shift+q kill, Mod+f fullscreen)
    Mod+Shift+Q repeat=false { close-window; }
    Mod+F { fullscreen-window; }
    Mod+Shift+Space { toggle-window-floating; }
    Mod+Shift+E { quit; }
    Mod+O repeat=false { toggle-overview; }
    Mod+Escape allow-when-locked=true { spawn-sh "noctalia msg session lock"; }
    Mod+F1 hotkey-overlay-title="Cheatsheet de atajos" { show-hotkey-overlay; }

    // Launch apps (from Sway: Mod+Shift+f)
    Mod+Shift+F { spawn-sh "code & flatpak run io.gitlab.librewolf-community"; }

    // Reload config (from Sway: Mod+Shift+c reload)
    Mod+Shift+C { spawn-sh "niri msg action load-config-file"; }

    // Focus columns/windows (as in Sway defaults + HJKL)
    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    // Move columns/windows (from Sway: Mod+Shift+arrows)
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Right { move-column-right; }

    // Window sizing
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+C { center-column; }

    // Workspace navigation (from Sway: Mod+1..0, Alt/Super+Tab)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Alt+Tab { focus-workspace-previous; }
    Mod+Shift+Tab { focus-workspace-down; }

    // Move to workspace (from Sway: Mod+Shift+1..0)
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // Switch keyboard layout (es <-> ru)
    Mod+Period { switch-layout "next"; }

    // Screenshots (from Sway)
    Print { spawn-sh "slurp | grim -g - - | wl-copy"; }
    Mod+Shift+S { spawn-sh "slurp | grim -g - ~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png"; }
    Mod+Print { spawn-sh "niri msg action screenshot-window"; }
    Ctrl+Print { spawn-sh "niri msg action screenshot-screen"; }

    // Audio via wpctl (Noctalia's volume IPC is unreliable with BT sinks)
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }
}

// General window appearance.
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

// Keep Noctalia settings floating and centered at a useful size.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Open apps on their assigned workspaces (migrated from Sway `assign`).
window-rule {
    match app-id="^brave-browser$"
    open-on-workspace "1"
}
window-rule {
    match app-id=r#"^io\.gitlab\.librewolf-community$"#
    open-on-workspace "1"
}
window-rule {
    match app-id=r#"^dev\.zed\.Zed$"#
    open-on-workspace "2"
}
window-rule {
    match app-id="^code$"
    open-on-workspace "2"
}
window-rule {
    match app-id="^Alacritty$"
    open-on-workspace "3"
}
window-rule {
    match app-id=r#"^com\.valvesoftware\.Steam$|^com\.spotify\.Client$"#
    open-on-workspace "4"
}

// Named workspaces: declared so open-on-workspace rules have a target.
workspace "1"
workspace "2"
workspace "3"
workspace "4"

// Noctalia surfaces request their own blur regions. Disable xray so blur samples
// the windows behind the surface instead of the wallpaper.
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

// Use Noctalia's blurred wallpaper as Niri's overview backdrop.
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

// Allow notification actions and window activation from Noctalia.
debug {
    honor-xdg-activation-with-invalid-serial
}

// Input defaults.
input {
    keyboard {
        xkb {
            layout "es,ru"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        dwt
    }

    focus-follows-mouse max-scroll-amount="0%"
    workspace-auto-back-and-forth
}

// Transparent workspace background lets Noctalia's wallpaper/backdrop show
// through in the overview.
layout {
    gaps 16
    background-color "transparent"
}

overview {
    workspace-shadow {
        off
    }
}
