#!/usr/bin/env python3
# Ryzen 7730U — perfil único de AHORRO DE BATERÍA.
# Solo importa cuando ADP1=0 (sin cargador): 6W, 2.2GHz, GPU powersaving.
# Al enchufar el cargador no hay perfil: se restaura stock MSI (25W, sin caps)
# para que PPD/ Governor manden. Cero lógica silenciosa/perf/stock-gaming.
import struct, sys, os, subprocess, glob

S = "/sys/kernel/ryzen_smu_drv/smu_args"
R = "/sys/kernel/ryzen_smu_drv/rsmu_cmd"

STOCK = dict(stapm=25000, slow=25000, fast=30000, tctl=100)
ULTRA = dict(stapm=6000, slow=8000, fast=12000, tctl=80)
ULTRA_MAX_FREQ = 2200000


def smu_send(cmd, val):
    open(S, "wb").write(struct.pack("<IIIIII", val & 0xFFFFFFFF, 0, 0, 0, 0, 0))
    open(R, "wb").write(struct.pack("<I", cmd & 0xFFFFFFFF))
    return struct.unpack("<I", open(R, "rb").read(4))[0]


def set_smu(stapm, slow, fast, tctl):
    for cmd, val, name in [(0x31, stapm, "STAPM"), (0x33, slow, "SLOW"), (0x32, fast, "FAST"), (0x37, tctl, "Tctl")]:
        try:
            st = smu_send(cmd, val)
            print(f" SMU 0x{cmd:02X} {name:6}={val:5} -> 0x{st:02X} {'OK' if st == 0x01 else 'FAIL'}")
        except Exception as e:
            print(f" SMU {name}: {e}")
            return False
    return True


def set_kernel(pref, gov, boost, max_freq):
    for i in range(16):
        try:
            open(f"/sys/devices/system/cpu/cpu{i}/cpufreq/scaling_governor", "w").write(gov)
        except Exception as e:
            if i == 0:
                print(f" gov {gov}: {e}")
        try:
            open(f"/sys/devices/system/cpu/cpu{i}/cpufreq/energy_performance_preference", "w").write(pref)
        except Exception as e:
            if i == 0:
                print(f" EPP {pref}: {e}")
    for i in range(16):
        for path in [f"/sys/devices/system/cpu/cpu{i}/cpufreq/scaling_max_freq",
                     f"/sys/devices/system/cpu/cpufreq/policy{i}/scaling_max_freq"]:
            try:
                open(path, "w").write(str(max_freq))
            except Exception:
                pass
    if boost is not None:
        try:
            open("/sys/devices/system/cpu/cpufreq/boost", "w").write(str(boost))
        except Exception:
            pass
    try:
        cur_max = open("/sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq").read().strip()
        cur_epp = open("/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference").read().strip()
        cur_gov = open("/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor").read().strip()
        print(f" Kernel: EPP={cur_epp} gov={cur_gov} maxfreq={cur_max} (pedido {max_freq})")
    except Exception:
        pass


def find_drm_base():
    for p in sorted(glob.glob("/sys/class/drm/card*/device/pp_power_profile_mode")):
        return os.path.dirname(p)
    for p in sorted(glob.glob("/sys/class/drm/card*/device/power_dpm_force_performance_level")):
        return os.path.dirname(p)
    return None


def gpu_restore_stock():
    base = find_drm_base()
    if not base:
        print(" GPU: no amdgpu drm encontrado (skip)")
        return
    try:
        open(os.path.join(base, "pp_od_clk_voltage"), "w").write("r")
        open(os.path.join(base, "pp_od_clk_voltage"), "w").write("c")
        open(os.path.join(base, "power_dpm_force_performance_level"), "w").write("auto")
        open(os.path.join(base, "pp_power_profile_mode"), "w").write("0")
        print(" GPU: stock restaurado (auto + BOOTUP_DEFAULT)")
    except Exception as e:
        print(f" GPU stock: {e}")


def gpu_battery():
    base = find_drm_base()
    if not base:
        print(" GPU: no amdgpu drm encontrado (skip)")
        return
    try:
        open(os.path.join(base, "power_dpm_force_performance_level"), "w").write("auto")
        open(os.path.join(base, "pp_power_profile_mode"), "w").write("2")
        print(" GPU: POWER_SAVING (perfil 2)")
    except Exception as e:
        print(f" GPU battery: {e}")


def battery():
    print("=== AHORRO BATERIA ULTRA (sin cargador) ===")
    print(" Objetivo: 6W, ~7.5h vs 5.5h stock, ultra silencioso, 2.2GHz cap.")
    set_smu(**ULTRA)
    set_kernel("power", "powersave", 1, ULTRA_MAX_FREQ)
    gpu_battery()
    print(" PPT 6/8/12W + 2.2GHz cap + EPP power + T80 = max vida.")
    print(" Extras: docker/BT off, USB autosuspend, brillo 40% (ver ryzen-battery-hook.sh).")


def restore():
    print("=== RESTAURAR STOCK MSI (cargador enchufado) ===")
    set_smu(**STOCK)
    # Sin caps de frecuencia: deja el techo al máximo detectado (stock)
    true_max = 4547946
    for p in ["/sys/devices/system/cpu/cpu0/cpufreq/amd_pstate_max_freq",
              "/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq",
              "/sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq"]:
        try:
            v = int(open(p).read().strip())
            if v > 2500000:
                true_max = v
                break
        except Exception:
            pass
    set_kernel("balance_performance", "powersave", 1, true_max)
    gpu_restore_stock()
    print(" Stock restaurado: sin caps propios. PPD/GPU mandan como en MSI de fábrica.")


def status():
    print("=== ESTADO ACTUAL ===")
    try:
        adp1 = open("/sys/class/power_supply/ADP1/online").read().strip()
    except Exception:
        adp1 = "?"
    print(f" ADP1: {adp1} ({'enchufado → stock' if adp1 == '1' else 'batería → ULTRA 6W'})")
    for i in range(2):
        try:
            gov = open(f"/sys/devices/system/cpu/cpu{i}/cpufreq/scaling_governor").read().strip()
            epp = open(f"/sys/devices/system/cpu/cpu{i}/cpufreq/energy_performance_preference").read().strip()
            mx = open(f"/sys/devices/system/cpu/cpu{i}/cpufreq/scaling_max_freq").read().strip()
            print(f" cpu{i}: gov={gov} EPP={epp} max={mx}")
        except Exception as e:
            print(f" cpu{i}: {e}")
    base = find_drm_base()
    if base:
        try:
            lvl = open(os.path.join(base, "power_dpm_force_performance_level")).read().strip()
            prof = open(os.path.join(base, "pp_power_profile_mode")).read().strip().splitlines()
            cur = next((l for l in prof if l.strip().endswith("*")), prof[0] if prof else "?")
            print(f" GPU level: {lvl} | {cur.strip()} @ {base}")
        except Exception as e:
            print(f" GPU: {e}")
    try:
        out = subprocess.run(["sensors"], capture_output=True, text=True, timeout=2).stdout
        for l in out.splitlines():
            if "Tctl" in l or "PPT" in l:
                print(f" {l.strip()}")
    except Exception:
        pass


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "battery":
        battery()
    elif mode == "restore":
        restore()
    elif mode == "status":
        status()
    else:
        print("Uso: sudo ryzen-profiles battery | restore | status")
        print("  battery — AHORRO BATERÍA ULTRA 6W (se aplica solo sin cargador)")
        print("  restore — vuelve a stock MSI (se aplica al enchufar cargador)")
        print("  status  — ADP1, CPU, GPU, temps")
        sys.exit(0 if mode == "" else 1)
