[Unit]
Description=Ryzen 7730U aplica perfil al arrancar segun ADP1 (bateria ULTRA / enchufado stock)
After=multi-user.target
Requires=ryzen_smu_loader.service
After=ryzen_smu_loader.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c ' /usr/libexec/ryzen_smu_loader.sh; ADP1=$(cat /sys/class/power_supply/ADP1/online 2>/dev/null); if [ "$ADP1" = "1" ]; then /usr/bin/ryzen-ac-hook.sh; else /usr/bin/ryzen-battery-hook.sh; fi'
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
