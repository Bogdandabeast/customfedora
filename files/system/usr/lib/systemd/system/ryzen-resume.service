[Unit]
Description=Ryzen 7730U re-aplica perfil tras resume (suspend/hibernate)
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
Requires=ryzen_smu_loader.service
After=ryzen_smu_loader.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c ' /usr/libexec/ryzen_smu_loader.sh; ADP1=$(cat /sys/class/power_supply/ADP1/online 2>/dev/null); if [ "$ADP1" = "1" ]; then /usr/bin/ryzen-ac-hook.sh; else /usr/bin/ryzen-battery-hook.sh; fi; /usr/bin/msi-battery-80.sh || true'
RemainAfterExit=no

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
