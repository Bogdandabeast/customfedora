{
    "layer": "top",
    "position": "top",

    "modules-left": [
        "sway/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "memory",
        "cpu",
        "network",
        "pulseaudio",
        "battery",
        "custom/tlp",
        "custom/bluetooth"
    ],

    "clock": {
        "format": "🕒 {:%H:%M}"
    },

    "cpu": {
        "format": "🖥️ {usage}%"
    },

    "memory": {
        "format": "💾 {percentage}%"
    },

    "network": {
        "format-wifi": "📶 {signalStrength}%",
        "format-ethernet": "🔌 {ipaddr}",
        "format-disconnected": "❌"
    },

    "pulseaudio": {
        "format": "🔊 {volume}%",
        "format-muted": "🔇"
    },

    "battery": {
        "format": "🔋 {capacity}%",
        "format-charging": "⚡ {capacity}%"
    },

    "custom/tlp": {
        "format": " {}",
        "exec": "~/.config/waybar/scripts/tlp.sh",
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/tlp-toggle.sh",
        "tooltip": true
    },

    "custom/bluetooth": {
        "format": " {}",
        "exec": "~/.config/waybar/scripts/bluetooth.sh",
        "interval": 5,
        "on-click": "blueman-manager",
        "on-click-right": "bluetoothctl power toggle",
        "tooltip": true
    }
}
